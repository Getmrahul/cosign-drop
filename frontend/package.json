{
  "name": "the-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/**/*.test.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:deploy": "npm run ci && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check:deploy && wrangler deploy"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.1"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
